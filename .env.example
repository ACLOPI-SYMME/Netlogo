# Copy this file to .env and adjust paths if NetLogo is installed elsewhere.
NETLOGO_HOME=C:\Program Files\NetLogo 6.4.0
JVM_PATH=C:\Program Files\NetLogo 6.4.0\runtime\bin\server\jvm.dll

# Docker Compose (docker-compose.yml): token shared by the platform and the agent.
# Leave it empty only for local development without authentication.
ACLOPI_AGENT_TOKEN=change-me

# DynamoDB region (default eu-north-1, Stockholm). DynamoDB Local ignores it.
ACLOPI_AWS_REGION=eu-north-1
