# Copy to terraform.tfvars (not in git). Only alert_email is required; the rest have defaults (variables.tf).
alert_email = "you@example.com"

# instance_type      = "m7i.xlarge"   # m7a.xlarge if the load test asks for more CPU
# schedule_start     = "45 8 * * 1-5" # Europe/Paris; ready ~09:00
# schedule_stop      = "0 12 * * 1-5"
# schedule_label     = "Monday to Friday, 09:00-12:00 (Paris time)"
# monthly_budget_usd = 30
# initial_capacity   = 1               # 0 = do not start the instance on the first apply
