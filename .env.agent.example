# Agent service (Línea A). Copy the lines you need into .env (not in git). No secrets here.
# Run with:  docker compose --profile agent up   and   ACLOPI_AGENT_URL=http://agent:8100
ACLOPI_AGENT_URL=http://agent:8100
ACLOPI_PLATFORM_URL=http://platform:8000
# ACLOPI_AGENT_TOKEN=            # shared with the platform
ACLOPI_LLM_PROVIDER=fake          # fake | ollama | anthropic
# ACLOPI_LLM_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=             # only for the anthropic provider
# ACLOPI_OLLAMA_URL=http://host.docker.internal:11434
# ACLOPI_OLLAMA_NUM_CTX=8192
LLM_MAX_PARALLEL=2
ACLOPI_U_WIDE=100
ACLOPI_U_NARROW=50
ACLOPI_WHATIF_P95_S=5.5
ACLOPI_LLM2_LATENCY_S=3
ACLOPI_FAST_DEADLINE_S=60
# Fake LLM (tests and smoke test)
ACLOPI_FAKE_LATENCY_S=0.5
ACLOPI_FAKE_INVALID_RATE=0.1
ACLOPI_FAKE_WHAT_IF_RATE=0.5
ACLOPI_FAKE_SEED=1
