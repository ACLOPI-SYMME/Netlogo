# Agent service (Línea A). Copy this file to .env.agent (not in git) and fill it in. No secrets here.
# The agent reads it (docker compose: env_file of the agent service; python -m aclopi.agent: loaded at start).
# Run with:  $env:ACLOPI_AGENT_URL="http://agent:8100"; docker compose --profile agent up -d --build
# ACLOPI_AGENT_URL is read by the PLATFORM: set it in the shell or in .env, not here.
# In docker compose ACLOPI_PLATFORM_URL and ACLOPI_AGENT_TOKEN (from .env, shared with the platform) are fixed.
ACLOPI_PLATFORM_URL=http://localhost:8000   # only for python -m aclopi.agent outside docker
# ACLOPI_AGENT_TOKEN=            # outside docker; same value as the platform's
ACLOPI_LLM_PROVIDER=fake          # fake | ollama | anthropic | openai_compat
# ACLOPI_LLM_MODEL=claude-haiku-5-5
# openai_compat (OpenAI-compatible server). The real values go in .env.agent (not in git; python -m
# aclopi.agent loads it), never in this file.
# ACLOPI_LLM_BASE_URL=https://host/v1
# ACLOPI_LLM_API_KEY=
# ACLOPI_LLM_TIMEOUT_S=30
# ACLOPI_LLM_MAX_TOKENS=200
# ACLOPI_LLM_REASONING_EFFORT=none   # empty: not sent
# ACLOPI_LLM_JSON_MODE=auto          # auto | json_schema | json_object | prompt
# ACLOPI_SEQUENCE_TIMEOUT_S=30       # POST /sequence/propose (docs/sequencing.md)
# ANTHROPIC_API_KEY=             # only for the anthropic provider
# ACLOPI_OLLAMA_URL=http://host.docker.internal:11434
# ACLOPI_OLLAMA_NUM_CTX=8192
LLM_MAX_PARALLEL=2
ACLOPI_U_WIDE=100
ACLOPI_U_NARROW=50
ACLOPI_WHATIF_P95_S=5.5
ACLOPI_LLM2_LATENCY_S=3
ACLOPI_FAST_DEADLINE_S=60
# Fake LLM (tests and smoke test)
ACLOPI_FAKE_LATENCY_S=0.5
ACLOPI_FAKE_INVALID_RATE=0.1
ACLOPI_FAKE_WHAT_IF_RATE=0.5
ACLOPI_FAKE_SEED=1
